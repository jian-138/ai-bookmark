      text-align: center;
    }

    .header h1 {
      font-size: 1.6em;
      margin-bottom: 5px;
    }

    .header p {
      font-size: 1em;
      opacity: 0.9;
      margin: 0;
    }

    .content {
      padding: 25px 20px;
    }

    .warning {
      background: #fff6e6;
      border-left: 4px solid #faad14;
      padding: 15px;
      margin: 20px 0;
      border-radius: 0 4px 4px 0;
    }

    .warning p {
